<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <PropertyGroup>
    <IsMainProject Condition="'$(MSBuildProjectName)' == 'RatalythMenu'">true</IsMainProject>
  </PropertyGroup>

  <!-- A missing game install used to fail silently: the build succeeded and dropped the DLL into a
       relative folder inside the repo instead of the game, which looked like a successful deploy. -->
  <Target Name="ValidateGamePath" BeforeTargets="BeforeBuild" Condition="'$(IsMainProject)' == 'true'">
    <Error Condition="'$(GamePath)' == ''"
      Text="Could not locate the Gorilla Tag install. Pass -p:GamePath=&quot;C:\path\to\Gorilla Tag&quot; or set the GAM_PATH environment variable." />
    <Error Condition="'$(GamePath)' != '' AND !Exists('$(GamePath)')"
      Text="GamePath points at '$(GamePath)', which does not exist." />
  </Target>

  <!-- Update Game References -->
  <Target Name="UpdateGameReferences" BeforeTargets="BeforeBuild" Condition="'$(IsMainProject)' == 'true' AND Exists('$(GameAssemblyPath)')">
    <ItemGroup>
      <GameAssemblyFiles Include="$(GameAssemblyPath)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(GameAssemblyFiles)"
      DestinationFolder="$(ProjectDir)References\Managed\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Update BepInEx References -->
  <Target Name="UpdateBepInExReferences" BeforeTargets="BeforeBuild" Condition="'$(IsMainProject)' == 'true' AND Exists('$(BepInExAssemblyPath)')">
    <ItemGroup>
      <BepInExAssemblyFiles Include="$(BepInExAssemblyPath)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BepInExAssemblyFiles)"
      DestinationFolder="$(ProjectDir)References\core\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Stamp the build time as assembly metadata.
       This used to be done by rewriting PluginInfo.cs on disk during the build, which dirtied a
       tracked source file on every build and left whatever timestamp the last person built in git.
       The metadata is written to obj instead and read back reflectively by PluginInfo.

       WriteCodeFragment is used directly rather than an AssemblyMetadata item because this project
       sets GenerateAssemblyInfo=false, which makes the SDK silently drop AssemblyMetadata items. -->
  <Target Name="StampBuildTimestamp" BeforeTargets="CoreCompile" Condition="'$(IsMainProject)' == 'true'">
    <ItemGroup>
      <!-- WriteCodeFragment uses the item type as the attribute type name and the metadata
           parameters named _Parameter1, _Parameter2 and so on, so the attribute has to be spelled
           out here. The SDK's GenerateAssemblyInfo target normally performs this conversion, but
           this project sets GenerateAssemblyInfo=false. -->
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTimestamp</_Parameter1>
        <_Parameter2>$(BuildTimestamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>

    <WriteCodeFragment
        AssemblyAttributes="@(AssemblyAttribute)"
        Language="C#"
        OutputDirectory="$(IntermediateOutputPath)"
        OutputFile="$(MSBuildProjectName).BuildStamp.generated.cs" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)$(MSBuildProjectName).BuildStamp.generated.cs" />
    </ItemGroup>
  </Target>

  <!-- Copy to Plugins -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CI)' != 'TRUE'">
    <ItemGroup>
      <FilesToCopy Include="$(TargetPath)"/>
      <FilesToCopy Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
	  <FilesToCopy Include="$(TargetDir)$(TargetName).dll" Condition="Exists('$(TargetDir)$(TargetName).dll')"/>
    </ItemGroup>

    <Copy SourceFiles="@(FilesToCopy)" DestinationFiles="@(FilesToCopy->'$(PluginsPath)\%(Filename)%(Extension)')"/>
    <Message Text="Copied $(TargetFileName) and $(TargetName).pdb to Plugins" Importance="high"/>
  </Target>
</Project>
